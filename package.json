{
  "main": "index.js",
  "name": "eslint-config-porcupine",
  "repository": "https://github.com/Deathspike/eslint-config-porcupine",
  "type": "module",
  "dependencies": {
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.0.0",
    "eslint-plugin-unicorn": "62.0.0",
    "typescript-eslint": "8.50.0"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "prettier-plugin-jsdoc": "1.8.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "scripts": {
    "eslint": "eslint --max-warnings 0",
    "prepack": "tsc index.js --allowJs --declaration --emitDeclarationOnly --removeComments --strict --skipLibCheck",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "npm run prettier:check && npm run tsc:build && npm run eslint",
    "tsc:build": "tsc --project jsconfig.json",
    "tsc:watch": "tsc --project jsconfig.json --watch"
  }
}
