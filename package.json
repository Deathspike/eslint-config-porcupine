{
  "main": "index.js",
  "name": "eslint-config-porcupine",
  "repository": "https://github.com/Deathspike/eslint-config-porcupine",
  "type": "module",
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-unicorn": "80.0.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">= 10"
    },
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">= 24"
    }
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "prepack": "tsc index.js --allowJs --declaration --emitDeclarationOnly --removeComments --strict --skipLibCheck",
    "test": "npm run types:check && npm run lint:check && npm run format:check",
    "types:check": "tsc --project jsconfig.json",
    "types:watch": "tsc --project jsconfig.json --watch"
  }
}
