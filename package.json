{
  "main": "index.js",
  "name": "eslint-config-porcupine",
  "repository": "https://github.com/Deathspike/eslint-config-porcupine",
  "type": "module",
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-unicorn": "76.0.0",
    "typescript-eslint": "8.70.1"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.11.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "prepack": "tsc index.js --allowJs --declaration --emitDeclarationOnly --removeComments --strict --skipLibCheck",
    "test": "npm run types:check && npm run lint:check && npm run format:check",
    "types:check": "tsc --project jsconfig.json",
    "types:watch": "tsc --project jsconfig.json --watch"
  }
}
